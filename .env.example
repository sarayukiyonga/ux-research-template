# ── Google Sheets / Service Account ───────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=ID_hoja_CEO_entrevista_e_informes
SURVEY_SHEET_ID=ID_hoja_encuesta_clientes_actuales
POTENTIAL_SURVEY_SHEET_ID=ID_hoja_encuesta_clientes_potenciales

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Autenticación ──────────────────────────────────────────────────────────────
AUTH_PASSWORD=elige_una_contraseña_segura
AUTH_SECRET=genera_con_openssl_rand_hex_32

# ── Configuración del cliente ──────────────────────────────────────────────────
# Única fuente de datos del cliente para la app: rellena aquí (o en Vercel).
# lib/client-config.ts solo lee estas variables; no hace falta duplicar nada en código.

CLIENT_NAME=NombreDelNegocio
CLIENT_OWNER_FIRST_NAME=NombreInformal
CLIENT_OWNER_FULL_NAME=Nombre Completo
CLIENT_OWNER_ROLE=fundador/a y CEO
CLIENT_LOCATION=Ciudad
CLIENT_LOCATION_REGION=Región o comarca
CLIENT_SECTOR=sector o industria
CLIENT_SERVICE_SHORT=descripción corta del servicio
CLIENT_SERVICE_DESCRIPTION=descripción larga del servicio
CLIENT_SERVICE_COMBO=servicio A + servicio B + servicio C
CLIENT_BRAND_CONCEPT=Concepto de marca
CLIENT_SERVICE_MODEL=presencial

# Opcional: prefijo ASCII para archivos PDF (por defecto se genera a partir de CLIENT_NAME)
# CLIENT_PDF_BASENAME=mi-marca
